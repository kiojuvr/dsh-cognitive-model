{
  "name": "@kioju/dsh-cognitive-model",
  "version": "0.8.0",
  "description": "A workspace-scoped graph of the cognitive model, the epistemic record and the world model, projected from an append-only event log, with the recall block a session starts from.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "pretest": "npm run build",
    "test": "node --test",
    "test:sandbox": "node scripts/run-tests.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "graph",
    "world-model",
    "cognitive-model",
    "memory",
    "recall"
  ],
  "author": "kiojuvr",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiojuvr/dsh-cognitive-model.git"
  },
  "bugs": {
    "url": "https://github.com/kiojuvr/dsh-cognitive-model/issues"
  },
  "homepage": "https://github.com/kiojuvr/dsh-cognitive-model#readme",
  "dependencies": {
    "@kioju/dsh-cognitive-core": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
